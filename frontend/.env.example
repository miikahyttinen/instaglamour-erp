# Copy to .env.local (gitignored) and adjust. Never put secrets or business values here.

# true = answer /api from in-browser MSW mocks (synthetic data only);
# false/unset = use the real backend through the Vite proxy (http://localhost:3000).
VITE_USE_MOCKS=false

# true = show the email dev-login form on the sign-in page
# (the backend must also have DEV_LOGIN_ENABLED=true).
VITE_DEV_LOGIN=false
