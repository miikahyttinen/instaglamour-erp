// Instaglamour ERP — database schema (see docs/domain-model.md).
// Money is stored as integer cents (EUR, excl. VAT). All tables have created_at / updated_at.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (keep in sync with src/domain/enums.ts)
// ---------------------------------------------------------------------------

enum Language {
  fi
  en
}

enum GigStatus {
  SOLD
  CANCELLED
}

enum TaskStatus {
  OPEN
  DONE
}

/// Roles (musician + internal) and expense categories in one list.
enum CostType {
  // Musician roles
  VOC
  BACKING_VOC
  BASS
  GUITAR
  DRUMS
  KEYS
  PIANO
  MIX
  HORN_1
  HORN_2
  SAX
  TRUMPET
  TROMBONE
  VIOLIN
  DJ
  TECHNICIAN
  OTHER_ROLE
  // Internal roles
  OFFICE
  SALES
  PRODUCTION
  // Expense categories
  FUEL
  VEHICLE
  TRAVEL
  PARKING
  ACCOMMODATION
  FOOD
  EQUIPMENT_RENTAL
  ARRANGEMENT
  LEAD_FEE
  OTHER
}

enum TechnicalSetup {
  HOUSE_TECH
  SET_A
  SET_B
  SET_C
}

enum Logistics {
  OWN_VAN
  RENTAL_VAN
  TAXI
  OTHER
}

enum GigEventType {
  CREATED
  UPDATED
  MOVED
  CANCELLED
  UNCANCELLED
  DELETED
  RESTORED
  COST_ADDED
  COST_UPDATED
  COST_REMOVED
  COST_PAID
  COST_UNPAID
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
}

/// Where an offer request came from (domain-model.md "Offer").
enum OfferSource {
  EMAIL
  WEBSITE
  INSTAGRAM
  OTHER
}

/// Kind of event an offer is for (Offer.event_type).
enum EventType {
  PRIVATE
  WEDDING
  CORPORATE
}

/// Outcome of an offer; the status is derived from it (BR-102).
enum OfferDisposition {
  PENDING
  WON
  CANCELLED
  NO_RESPONSE
  LOST_PRICE
  LOST_COMPETITOR
  LOST_OTHER
  NO_CAPACITY
}

/// Offer history (BR-103).
/// Purchase order status (BR-117): OPEN -> PAID -> OPEN, OPEN -> CANCELLED (final).
enum PurchaseOrderStatus {
  OPEN
  PAID
  CANCELLED
}

/// Purchase order history (BR-119).
enum PurchaseOrderEventType {
  CREATED
  PAID
  UNPAID
  CANCELLED
}

enum OfferEventType {
  CREATED
  UPDATED
  DISPOSITION_CHANGED
  CONVERTED
  LINK_REGENERATED
  DELETED
  RESTORED
}

// ---------------------------------------------------------------------------
// People and partners
// ---------------------------------------------------------------------------

model Person {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  active          Boolean  @default(true)
  /// Secret freelancer link token (BR-113): 32 CSPRNG bytes, base64url (43 chars). The DB default
  /// gives every new row one (also seed rows); regenerate replaces it (src/purchaseOrders/token.ts).
  freelancerToken String   @unique @default(dbgenerated("translate(rtrim(encode(sha256(convert_to(gen_random_uuid()::text || gen_random_uuid()::text || gen_random_uuid()::text, 'UTF8')), 'base64'), '='), '+/', '-_')")) @map("freelancer_token")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  partner        Partner?
  costLines      CostLine[]
  purchaseOrders PurchaseOrder[]

  @@map("person")
}

model Partner {
  id           String    @id @default(uuid()) @db.Uuid
  personId     String    @unique @map("person_id") @db.Uuid
  email        String    @unique
  language     Language  @default(fi)
  /// Selected year (BR-081). null = current year.
  selectedYear Int?      @map("selected_year")
  /// Optional; shown on the public offer as the seller's contact (local seed).
  phone        String?
  /// UC-032 / BR-110..112: only active partners can sign in or be chosen for new records.
  /// Email is also unique case-insensitively (index "partner_email_lower_key", migration only).
  active       Boolean   @default(true)
  grantedById  String?   @map("granted_by") @db.Uuid
  grantedAt    DateTime? @map("granted_at")
  revokedById  String?   @map("revoked_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  person                  Person               @relation(fields: [personId], references: [id])
  grantedBy               Partner?             @relation("PartnerGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy               Partner?             @relation("PartnerRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  granted                 Partner[]            @relation("PartnerGrantedBy")
  revoked                 Partner[]            @relation("PartnerRevokedBy")
  soldGigs                Gig[]                @relation("GigSeller")
  producedGigs            Gig[]                @relation("GigProducer")
  deletedGigs             Gig[]                @relation("GigDeletedBy")
  paidCostLines           CostLine[]           @relation("CostLinePaidBy")
  uploadedAttachments     Attachment[]
  gigEvents               GigEvent[]
  tasks                   Task[]
  hourEntries             HourEntry[]
  sessions                Session[]
  soldOffers              Offer[]              @relation("OfferSeller")
  offerEvents             OfferEvent[]
  paidPurchaseOrders      PurchaseOrder[]      @relation("PurchaseOrderPaidBy")
  cancelledPurchaseOrders PurchaseOrder[]      @relation("PurchaseOrderCancelledBy")
  purchaseOrderEvents     PurchaseOrderEvent[]

  @@map("partner")
}

/// Server-side login session (UC-001). The cookie holds a random token; only its hash is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  partnerId String   @map("partner_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("session")
}

// ---------------------------------------------------------------------------
// Seeded reference data
// ---------------------------------------------------------------------------

model LineupTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles TemplateRole[]
  gigs  Gig[]

  @@map("lineup_template")
}

model TemplateRole {
  id              String   @id @default(uuid()) @db.Uuid
  templateId      String   @map("template_id") @db.Uuid
  position        Int
  role            CostType
  defaultFeeCents Int      @map("default_fee_cents")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  template LineupTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@map("template_role")
}

/// Seeded key/value settings: fee settings are money amounts in cents (value_cents), offer
/// settings are texts (value_text).
model Setting {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  valueCents Int?     @map("value_cents")
  valueText  String?  @map("value_text")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("setting")
}

// ---------------------------------------------------------------------------
// Gigs
// ---------------------------------------------------------------------------

model Gig {
  id                         String          @id @default(uuid()) @db.Uuid
  startDate                  DateTime        @map("start_date") @db.Date
  endDate                    DateTime?       @map("end_date") @db.Date
  status                     GigStatus       @default(SOLD)
  lineupTemplateId           String?         @map("lineup_template_id") @db.Uuid
  lineupName                 String          @map("lineup_name")
  venue                      String
  technicalSetup             TechnicalSetup? @map("technical_setup")
  logistics                  Logistics?
  houseTechnician            Boolean         @default(false) @map("house_technician")
  sellerId                   String          @map("seller_id") @db.Uuid
  producerId                 String          @map("producer_id") @db.Uuid
  priceCents                 Int             @map("price_cents")
  additionalSalesCents       Int             @default(0) @map("additional_sales_cents")
  additionalSalesDescription String?         @map("additional_sales_description")
  notes                      String?
  /// Optional client (BR-100); a linked client can't be deleted (BR-101).
  clientId                   String?         @map("client_id") @db.Uuid
  /// The offer this gig was converted from (BR-105); unique = at most one gig per offer.
  offerId                    String?         @unique @map("offer_id") @db.Uuid
  deletedAt                  DateTime?       @map("deleted_at")
  deletedById                String?         @map("deleted_by") @db.Uuid
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")

  lineupTemplate     LineupTemplate?     @relation(fields: [lineupTemplateId], references: [id])
  seller             Partner             @relation("GigSeller", fields: [sellerId], references: [id])
  producer           Partner             @relation("GigProducer", fields: [producerId], references: [id])
  deletedBy          Partner?            @relation("GigDeletedBy", fields: [deletedById], references: [id])
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  offer              Offer?              @relation(fields: [offerId], references: [id], onDelete: Restrict)
  costLines          CostLine[]
  attachments        Attachment[]
  events             GigEvent[]
  purchaseOrderLines PurchaseOrderLine[]

  technicalSetupLegacy GigTechnicalSetupLegacy?

  @@index([startDate])
  @@index([clientId])
  @@map("gig")
}

// ---------------------------------------------------------------------------
// Clients (UC-027, BR-100, BR-101)
// ---------------------------------------------------------------------------

/// A client: name + notes only (BR-007). Names are unique case-insensitively and trimmed among
/// non-deleted clients (partial unique index "client_active_name_key" on lower(btrim(name))
/// WHERE deleted_at IS NULL, created in migration 20261007120000_clients). Soft delete only.
model Client {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  notes     String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  gigs   Gig[]
  offers Offer[]

  @@map("client")
}

// ---------------------------------------------------------------------------
// Offers (UC-028…UC-031, BR-102…BR-107)
// ---------------------------------------------------------------------------

/// An offer to a client. Status is derived from the disposition (BR-102). The gig created by
/// "Convert to gig" points back here (gig.offer_id, unique).
model Offer {
  id             String           @id @default(uuid()) @db.Uuid
  clientId       String           @map("client_id") @db.Uuid
  eventName      String           @map("event_name")
  eventDate      DateTime         @map("event_date") @db.Date
  venue          String
  city           String?
  /// Shown to the customer, one item per line.
  lineup         String[]         @default([])
  includesText   String?          @map("includes_text")
  /// OBSOLETE (TASK-022): no longer read or written; the public offer always uses SPOTIFY_URL
  /// (src/offers/constants.ts). Column kept so existing data is not dropped.
  spotifyUrl     String?          @map("spotify_url")
  /// Internal only, excl. VAT; never shown on the public page (BR-104).
  priceCents     Int?             @map("price_cents")
  sellerId       String           @map("seller_id") @db.Uuid
  showReferences Boolean          @default(false) @map("show_references")
  source         OfferSource?
  eventType      EventType?       @map("event_type")
  disposition    OfferDisposition @default(PENDING)
  /// Public link token (BR-104): 32 random bytes, base64url. Kept to build the share link.
  shareToken     String           @unique @map("share_token")
  /// SHA-256 (hex) of share_token; the public endpoint looks offers up by this hash.
  shareTokenHash String           @unique @map("share_token_hash")
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  client Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  seller Partner      @relation("OfferSeller", fields: [sellerId], references: [id])
  gig    Gig?
  events OfferEvent[]

  @@index([eventDate])
  @@index([clientId])
  @@map("offer")
}

/// Full, append-only offer history (BR-103).
model OfferEvent {
  id        String         @id @default(uuid()) @db.Uuid
  offerId   String         @map("offer_id") @db.Uuid
  type      OfferEventType
  partnerId String         @map("partner_id") @db.Uuid
  at        DateTime       @default(now())
  details   Json           @default("{}")
  /// Insertion order; breaks ties between events with the same `at` (history is newest first).
  seq       BigInt         @default(autoincrement())
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([offerId, at])
  @@map("offer_event")
}

/// Original multi-select technical_setup array of gigs that existed before TASK-010 (migration
/// 20261005120000_technical_setup_single_logistics). Kept so no information is lost; not used by the API.
model GigTechnicalSetupLegacy {
  gigId          String   @id @map("gig_id") @db.Uuid
  technicalSetup String[] @map("technical_setup")
  migratedAt     DateTime @default(now()) @map("migrated_at")

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@map("gig_technical_setup_legacy")
}

model CostLine {
  id                          String    @id @default(uuid()) @db.Uuid
  gigId                       String    @map("gig_id") @db.Uuid
  type                        CostType
  personId                    String?   @map("person_id") @db.Uuid
  description                 String?
  budgetedCents               Int       @map("budgeted_cents")
  /// Musician roles only (BR-026); null for internal roles and expenses.
  joinsLoadIn                 Boolean?  @map("joins_load_in")
  loadInDeductionAppliedCents Int?      @map("load_in_deduction_applied_cents")
  actualCents                 Int?      @map("actual_cents")
  paidAt                      DateTime? @map("paid_at")
  paidById                    String?   @map("paid_by") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  gig                Gig                 @relation(fields: [gigId], references: [id], onDelete: Cascade)
  person             Person?             @relation(fields: [personId], references: [id])
  paidBy             Partner?            @relation("CostLinePaidBy", fields: [paidById], references: [id])
  purchaseOrderLines PurchaseOrderLine[]

  @@index([gigId])
  @@index([personId])
  @@map("cost_line")
}

model Attachment {
  id           String    @id @default(uuid()) @db.Uuid
  gigId        String    @map("gig_id") @db.Uuid
  filename     String
  contentType  String    @map("content_type")
  sizeBytes    Int       @map("size_bytes")
  /// File name inside UPLOAD_DIR.
  storageKey   String    @unique @map("storage_key")
  uploadedById String    @map("uploaded_by") @db.Uuid
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  gig        Gig     @relation(fields: [gigId], references: [id], onDelete: Cascade)
  uploadedBy Partner @relation(fields: [uploadedById], references: [id])

  @@index([gigId])
  @@map("attachment")
}

/// Full, append-only gig history (BR-015).
model GigEvent {
  id        String       @id @default(uuid()) @db.Uuid
  gigId     String       @map("gig_id") @db.Uuid
  type      GigEventType
  partnerId String       @map("partner_id") @db.Uuid
  at        DateTime     @default(now())
  reason    String?
  details   Json         @default("{}")
  /// Insertion order; breaks ties between events with the same `at` (history is newest first).
  seq       BigInt       @default(autoincrement())
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  gig     Gig     @relation(fields: [gigId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([gigId, at])
  @@map("gig_event")
}

// ---------------------------------------------------------------------------
// Tasks and hours
// ---------------------------------------------------------------------------

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String?
  dueDate     DateTime?  @map("due_date") @db.Date
  ownerId     String     @map("owner_id") @db.Uuid
  status      TaskStatus @default(OPEN)
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner Partner @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("task")
}

model HourEntry {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  date      DateTime @db.Date
  comment   String
  /// 0.25…24 in 0.25 steps (BR-050).
  hours     Decimal  @db.Decimal(4, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId, date])
  @@map("hour_entry")
}

// ---------------------------------------------------------------------------
// Yearly budget
// ---------------------------------------------------------------------------

/// A budget row, managed by the partners (UC-020). Active names are unique case-insensitively
/// (partial unique index "budget_category_active_name_key" on lower(btrim(name)) WHERE active,
/// created in migration 20261005200000_budget_category_name).
model BudgetCategory {
  id        String   @id @default(uuid()) @db.Uuid
  /// Optional stable key used only by seed files for idempotency; null for rows added in the app.
  code      String?  @unique
  /// One name, shown in both languages.
  name      String
  /// Removing a row sets false: hidden from every year and total, its values are kept.
  active    Boolean  @default(true)
  /// Display order (creation order).
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  years  BudgetYear[]
  legacy BudgetCategoryLegacy?

  @@map("budget_category")
}

/// Original values of the budget categories that existed before TASK-012 (migration
/// 20261005200000_budget_category_name). Kept so no information is lost; not used by the API.
model BudgetCategoryLegacy {
  categoryId String   @id @map("category_id") @db.Uuid
  code       String
  nameFi     String   @map("name_fi")
  nameEn     String   @map("name_en")
  budgeted   Boolean
  active     Boolean
  migratedAt DateTime @default(now()) @map("migrated_at")

  category BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("budget_category_legacy")
}

model BudgetYear {
  id                 String   @id @default(uuid()) @db.Uuid
  categoryId         String   @map("category_id") @db.Uuid
  year               Int
  budgetExpenseCents Int      @default(0) @map("budget_expense_cents")
  budgetIncomeCents  Int      @default(0) @map("budget_income_cents")
  actualExpenseCents Int      @default(0) @map("actual_expense_cents")
  actualIncomeCents  Int      @default(0) @map("actual_income_cents")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  category BudgetCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, year])
  @@index([year])
  @@map("budget_year")
}

// ---------------------------------------------------------------------------
// References / testimonials (BR-108)
// ---------------------------------------------------------------------------

/// A testimonial shown on offers with show_references (BR-108). Replaces the old text settings
/// offers.references_fi / offers.references_en (those rows are left in place but no longer read).
/// The optional photo is a file in UPLOAD_DIR, stored like attachments: either all four
/// image_* columns are set or none (check constraint "reference_image_all_or_none").
model Reference {
  id               String    @id @default(uuid()) @db.Uuid
  quoteFi          String    @map("quote_fi")
  quoteEn          String?   @map("quote_en")
  author           String
  sortOrder        Int       @map("sort_order")
  active           Boolean   @default(true)
  /// File name inside UPLOAD_DIR (random UUID); null = no photo.
  imageStorageKey  String?   @unique @map("image_storage_key")
  /// Sniffed from the file content: image/png, image/jpeg or image/webp.
  imageContentType String?   @map("image_content_type")
  imageSizeBytes   Int?      @map("image_size_bytes")
  /// When the current photo was uploaded; its epoch milliseconds are the API's `imageVersion`.
  imageUploadedAt  DateTime? @map("image_uploaded_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("reference")
}

// ---------------------------------------------------------------------------
// Purchase orders (UC-033, UC-034, BR-113…BR-119)
// ---------------------------------------------------------------------------

/// A purchase order created by a freelancer through their link. `number` = name slug + global
/// running number `seq` (DB sequence "purchase_order_seq", BR-116).
model PurchaseOrder {
  id            String              @id @default(uuid()) @db.Uuid
  number        String              @unique
  seq           Int                 @unique
  personId      String              @map("person_id") @db.Uuid
  status        PurchaseOrderStatus @default(OPEN)
  totalCents    Int                 @map("total_cents")
  paidAt        DateTime?           @map("paid_at")
  paidById      String?             @map("paid_by") @db.Uuid
  cancelledAt   DateTime?           @map("cancelled_at")
  cancelledById String?             @map("cancelled_by") @db.Uuid
  cancelReason  String?             @map("cancel_reason")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  person      Person               @relation(fields: [personId], references: [id])
  paidBy      Partner?             @relation("PurchaseOrderPaidBy", fields: [paidById], references: [id])
  cancelledBy Partner?             @relation("PurchaseOrderCancelledBy", fields: [cancelledById], references: [id])
  lines       PurchaseOrderLine[]
  events      PurchaseOrderEvent[]

  @@index([personId])
  @@index([createdAt])
  @@map("purchase_order")
}

/// One fee on a purchase order, with the amount snapshot (BR-115). `active` is true while the PO
/// is OPEN or PAID; a cost line is on at most one active line (partial unique index
/// "purchase_order_line_active_cost_line_key", migration only). `costLineRef` always keeps the
/// original cost line id; `costLineId` (the FK) becomes null if the cost line is deleted after
/// the PO was cancelled. gig/type/description are snapshots for that case.
model PurchaseOrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  costLineId      String?  @map("cost_line_id") @db.Uuid
  costLineRef     String   @map("cost_line_ref") @db.Uuid
  gigId           String   @map("gig_id") @db.Uuid
  type            CostType
  description     String?
  amountCents     Int      @map("amount_cents")
  active          Boolean  @default(true)
  position        Int
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  costLine      CostLine?     @relation(fields: [costLineId], references: [id], onDelete: SetNull)
  gig           Gig           @relation(fields: [gigId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, position])
  @@index([costLineId])
  @@index([gigId])
  @@map("purchase_order_line")
}

/// Append-only purchase order history (BR-119). partner_id null = the freelancer via the link.
model PurchaseOrderEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  purchaseOrderId String                 @map("purchase_order_id") @db.Uuid
  type            PurchaseOrderEventType
  partnerId       String?                @map("partner_id") @db.Uuid
  at              DateTime               @default(now())
  details         Json                   @default("{}")
  /// Insertion order; breaks ties between events with the same `at` (newest first).
  seq             BigInt                 @default(autoincrement())
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  partner       Partner?      @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId, at])
  @@index([at])
  @@map("purchase_order_event")
}
