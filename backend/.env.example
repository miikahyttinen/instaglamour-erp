# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.

# Server
PORT=3000
# Bind address: 127.0.0.1 by default, 0.0.0.0 when NODE_ENV=production.
# HOST=127.0.0.1
# production = serve ../frontend/dist (FRONTEND_DIST_DIR) and refuse unsafe config. Leave unset locally.
# NODE_ENV=production

# Databases (match docker-compose.yml at the repo root)
DATABASE_URL=postgresql://instaglamour:instaglamour@localhost:5432/instaglamour
TEST_DATABASE_URL=postgresql://instaglamour:instaglamour@localhost:5433/instaglamour_test

# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth client (Google Cloud console → Credentials → OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# Only Google accounts in this domain may sign in (BR-070)
AUTH_ALLOWED_DOMAIN=example.com
# Optional: exact addresses outside that domain that are treated as if they were in it
# (comma-separated, case-insensitive). They must still be active partners to sign in.
# An entry that is not an email address stops startup. Leave empty for none.
# AUTH_EXTRA_ALLOWED_EMAILS=someone@example.org,another.person@example.net

# Local-only shortcut login (POST /api/auth/dev-login). Never enable outside local development.
DEV_LOGIN_ENABLED=false

# Automatic final invoice job ("Loppulasku" 48 h after an event; startup + every 15 min). Default on.
# INVOICE_JOB_ENABLED=false

# Where the browser is sent after sign-in (the frontend dev server)
FRONTEND_URL=http://localhost:5173

# Legacy file directory, outside the repository. Reference photos are stored in the database; older photo
# files found here are moved into the database at startup (files are never deleted). May be missing.
UPLOAD_DIR=../../instaglamour-uploads
